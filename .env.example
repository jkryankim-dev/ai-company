# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋되지 않습니다.

# --- z.ai (실무진 엔진) ---
ZAI_API_KEY=
ZAI_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# --- Claude (임원진 엔진) ---
# claude setup-token 으로 발급. ANTHROPIC_API_KEY 는 반드시 비워둘 것(종량과금 방지)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# --- Discord (사옥) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- GitHub (업무 SSOT) ---
GITHUB_REPO=

# --- 제품 저장소 (직원들이 읽고 작업할 앱 소스) ---
APP_REPO=C:\dev\hanoi
